# Copy to .env (gitignored). Free providers first.
LLM_PROVIDER=gemini            # groq | gemini | openrouter | ollama | anthropic
# LLM_MODEL=                 # override the preset model (must support tool calling)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier limits, enforced client-side (unset = no limit). Find yours in the provider console.
# Example: Gemini Flash Lite free tier
LLM_RPM=15
LLM_TPM=250000
LLM_RPD=500
# LLM_LIMIT_MARGIN=0.9       # use 90% of each limit
HKRISK_API_KEY=            # required for POST /agent/ask; >= 24 random chars: python -c "import secrets; print(secrets.token_urlsafe(32))"
# HKRISK_CORS_ORIGINS=https://your-dashboard.example   # only when the dashboard is hosted on another origin
