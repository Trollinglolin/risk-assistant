{"Version": "2012-10-17", "Statement": [
  {"Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"],
   "Resource": "arn:aws:s3:::hkrisk-*/*"},
  {"Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": "arn:aws:s3:::hkrisk-*"},
  {"Effect": "Allow", "Action": ["ssm:GetParametersByPath", "ssm:GetParameter"],
   "Resource": ["arn:aws:ssm:*:*:parameter/hkrisk", "arn:aws:ssm:*:*:parameter/hkrisk/*"]}
]}
